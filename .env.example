# Precifica+ — variáveis de ambiente (exemplo)
# Copie para .env e preencha com os valores reais. NUNCA comitar o .env.

# ── Supabase (Project Settings → API) ───────────────────────
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=coloque-a-chave-anon-public-aqui

# Conexão direta ao Postgres (usada pela API Python — Fase 4)
# Project Settings → Database → Connection string → URI (pooler, porta 6543)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-regiao.pooler.supabase.com:6543/postgres

# Segredo para a API validar o JWT do Supabase (Fase 4)
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=coloque-o-jwt-secret-aqui
