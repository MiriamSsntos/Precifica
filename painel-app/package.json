{
  "name": "precifica-painel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Painel Precifica+ — React + Vite + TypeScript, 100% Supabase (sem backend próprio).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check src",
    "format": "biome check --write src",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
